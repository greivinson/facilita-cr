# ============================================================
# FacilitaCR — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a .env y completa tus valores reales
# ============================================================

# Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Telegram Bot (Obtenido con @BotFather)
TELEGRAM_BOT_TOKEN=
# IDs de Telegram autorizados separados por coma (ver @userinfobot)
TELEGRAM_ALLOWED_IDS=

# Opcionales para Fallback gratuito de IA
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_FREE_MODEL_IDS=
GROQ_FREE_MODEL_IDS=

# Optional AI ranker; must identify an active, free-approved catalog model.
MODEL_RANKER_PROVIDER=
MODEL_RANKER_MODEL_ID=
